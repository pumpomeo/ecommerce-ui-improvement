{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ứng dụng quản lý công việc cá nhân",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:local": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "db:init": "node --env-file-if-exists=.env database/setup.js",
    "db:seed": "node --env-file-if-exists=.env database/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
